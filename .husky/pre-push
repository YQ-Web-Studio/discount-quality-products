#!/bin/sh
branch="$(git symbolic-ref --short HEAD 2>/dev/null)"

if [ "$branch" = "main" ]; then
  echo "❌ Direct push to 'main' is blocked. Please branch off and open a Pull Request."
  exit 1
fi

# Enforce branch naming convention: <type>/<TICKET>-<description> or <type>/<description>
valid_branch_regex="^(feat|fix|test|refactor|perf|chore|docs|ci|spike|hotfix)\/(([A-Z]+-[0-9]+-)?[a-z0-9-]+)$"
if ! echo "$branch" | grep -Eq "$valid_branch_regex"; then
  echo "❌ Invalid branch name: '$branch'"
  echo "Branch names must follow: <type>/<TICKET-KEY>-<description>"
  echo "Allowed types: feat, fix, test, refactor, perf, chore, docs, ci, spike, hotfix"
  echo "Examples: feat/DQP-12-checkout-vat, fix/MA-18-prayer-offset, docs/DQP-1-workflow"
  exit 1
fi
